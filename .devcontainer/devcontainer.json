{
    "name": "Company Access Management",
    "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "GitHub.vscode-github-actions"
            ]
        }
    },
    "forwardPorts": [5000],
    "postCreateCommand": "dotnet restore CompanyAccessManagement.slnx",
    "remoteUser": "vscode",
    "hostRequirements": {
        "memory": "8gb"
    }
}
