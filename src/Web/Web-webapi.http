# For more info on HTTP files go to https://aka.ms/vs/httpfile
@Web_HostAddress = https://localhost:5001

@Email=administrator@localhost
@Password=Administrator1!
@BearerToken=<YourToken>
@CompanyId=<YourCompanyId>

# Log in (ASP.NET Core Identity bearer tokens)
POST {{Web_HostAddress}}/login
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

###

# Refresh token
POST {{Web_HostAddress}}/refresh
Content-Type: application/json

{
  "refreshToken": ""
}

###

# List positions in the workspace company
GET {{Web_HostAddress}}/api/v1/organization/positions/
Authorization: Bearer {{BearerToken}}
X-Company-Id: {{CompanyId}}

###

# List personnel visible in the workspace company
GET {{Web_HostAddress}}/api/v1/organization/personnel/
Authorization: Bearer {{BearerToken}}
X-Company-Id: {{CompanyId}}

###

# List roles in the workspace company
GET {{Web_HostAddress}}/api/v1/access-control/roles/
Authorization: Bearer {{BearerToken}}
X-Company-Id: {{CompanyId}}

###
